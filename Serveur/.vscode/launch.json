{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch Odroid",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/prog",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "preLaunchTask": "Deploy to Odroid and start gdbserver",
      "MIMode": "gdb",
      "targetArchitecture": "arm64",
      "miDebuggerPath": "/opt/poky/4.0.28/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",

      "miDebuggerServerAddress": "192.168.7.2:3000",

      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set sysroot",
          "text": "-gdb-set sysroot /opt/poky/4.0.28/sysroots/cortexa53-poky-linux",
          "ignoreFailures": false
        }
      ]
    }
  ]
}