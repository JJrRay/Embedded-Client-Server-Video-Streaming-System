{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug Poste",
      "type": "shell",
      "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug . && cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
    {
      "label": "Build Release Poste",
      "type": "shell",
      "command": "cmake -B build -DCMAKE_BUILD_TYPE=Release . && cmake --build build",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Rebuild Poste",
      "type": "shell",
      "command": "rm -rf build && cmake -B build -DCMAKE_BUILD_TYPE=Debug . && cmake --build build",
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}