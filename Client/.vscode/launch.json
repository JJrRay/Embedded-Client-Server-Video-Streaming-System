{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/prog",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        },
        {
          "description": "Laisser SIGINT atteindre le programme",
          "text": "handle SIGINT nostop noignore pass",
          "ignoreFailures": true
        }
      ]
    }
  ]
}